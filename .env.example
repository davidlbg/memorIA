# Local development only. Generate a unique AUTH_SECRET with python scripts/setup.py.
DATABASE_URL=postgresql+psycopg://memory:memory@127.0.0.1:55432/memory
AUTH_SECRET=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
EXTERNAL_AI_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional query-only override; workers retain LLM_MODEL. GPT-5.4 mini uses
# Responses with reasoning, store=false and bounded per-query research.
# OPENAI_QUERY_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
PROVIDER_TIMEOUT_SECONDS=45
# Local Ollama is opt-in. Use scripts/prepare_personal.py for an isolated
# installation with pinned models; changing dimensions requires a new database
# or an explicitly planned migration, never only an environment change.
LOCAL_AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_LLM_DIGEST=
OLLAMA_EMBEDDING_DIGEST=
LOCAL_AI_CONTEXT_CHARACTERS=8000
LOCAL_AI_TIMEOUT_SECONDS=300
LOCAL_AI_MAX_OUTPUT_TOKENS=3072
WORKER_BATCH_MESSAGES=20
LOG_LEVEL=INFO
IMPORT_MAX_BYTES=5000000
WORKER_POLL_SECONDS=2
# Optional shared monthly OpenAI accounting, in USD. Omitted disables the guard.
# Set the month's prior spend explicitly before enabling; YYYY-MM uses UTC.
# AI_MONTHLY_BUDGET_USD=50
AI_BUDGET_PRIOR_SPEND_USD=0
# AI_BUDGET_PRIOR_SPEND_MONTH=2026-11
# Role is set per service by infrastructure/personal.compose.yml.
AI_USAGE_ROLE=queries
# false when the dedicated indexer owns original-message embeddings.
WORKER_INDEXES_MESSAGES=true
# Optional exact origin, e.g. chrome-extension://<your-extension-id>
EXTENSION_ORIGIN=
# Optional connector profile. scripts/setup.py generates .env.connector and a
# separate 32-byte encryption key; network access remains disabled by default.
CONNECTOR_URL=http://127.0.0.1:3001
CONNECTOR_MAX_EVENTS=500000
CONNECTOR_MAX_PENDING=5000
