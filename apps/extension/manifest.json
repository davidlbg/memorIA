{
  "manifest_version": 3,
  "name": "MemorIA",
  "version": "0.2.0",
  "description": "Memória local de conversas importadas do WhatsApp, com fontes verificáveis.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Abrir MemorIA",
    "default_icon": {
      "16": "brand/memoria-16.png",
      "32": "brand/memoria-32.png",
      "48": "brand/memoria-48.png",
      "128": "brand/memoria-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "brand/memoria-16.png",
    "32": "brand/memoria-32.png",
    "48": "brand/memoria-48.png",
    "128": "brand/memoria-128.png"
  }
}
